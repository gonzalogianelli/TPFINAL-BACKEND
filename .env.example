PORT=3000
NODE_ENV=development

# Base de datos MySQL (MySQL Workbench)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_padel
DB_USER=root
DB_PASSWORD=

# Autenticación JWT y Cookie HTTPOnly
JWT_SECRET=reemplazar_por_un_secreto_seguro_en_env
JWT_EXPIRES_IN=1d
COOKIE_NAME=padel_token
COOKIE_SAME_SITE=lax

# CORS
CLIENT_URL=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Notificaciones por correo (Nodemailer)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Complejo de Pádel <no-reply@complejopadel.com>"